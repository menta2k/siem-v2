# Example environment for the compose stack. Copy to .env alongside the
# compose file (git ignores .env) and fill in what you use:
#
#     cp deploy/compose/.env.example deploy/compose/.env
#
# Compose reads this file automatically; the variables below are the ones
# interpolated into docker-compose.yml. The application services (apiserver,
# logproc, retentiond) run on the HOST in this stack and take their secrets
# from the shell environment, not from this file — see docs/deployment.md.

# Cloudflare Tunnel connector token, from the Zero Trust dashboard
# (Networks → Tunnels → your tunnel → token). Only needed when starting the
# tunnel profile:
#
#     docker compose --profile tunnel up -d
#
# Without the profile the stack ignores this entirely; cloudflared exits
# loudly if the profile is started with the token left empty.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------- credentials
# Unset, the stack starts with obviously-dev defaults (siem / siem_dev_only)
# so local development needs no .env at all. Set real values for anything
# beyond a laptop. Changing them after first start does NOT update an already
# initialised Postgres volume — recreate the volume or alter the role by hand.

# PostgreSQL (host services read the matching DSN from SIEM_PG_DSN)
SIEM_PG_USER=
SIEM_PG_PASSWORD=
SIEM_PG_DB=

# RustFS object store (retentiond reads the matching SIEM_S3_ACCESS_KEY /
# SIEM_S3_SECRET_KEY from its own environment)
SIEM_S3_ACCESS_KEY=
SIEM_S3_SECRET_KEY=

# ---------------------------------------------------------------- app profile
# Used only by `docker compose --profile app up` (the full containerised
# stack). Unset, dev-only defaults apply — fine on a laptop, never beyond it.

# JWT signing key: at least 32 bytes, or the apiserver refuses to start.
SIEM_JWT_KEY=
# MFA sealing key: EXACTLY 32 bytes. Rotating it strands already-enrolled
# TOTP secrets — users re-enrol at next sign-in.
SIEM_MFA_KEY=
# Shared secret for the legacy ingest routes (per-feed tokens are managed in
# the UI and stored hashed; they never appear here).
SIEM_INGEST_SECRET=
# Browser origins allowed to call the API. Explicit origins only, never *.
SIEM_CORS_ORIGINS=
# First-start bootstrap administrator (see docs/deployment.md).
SIEM_ADMIN_EMAIL=

# Browser-facing URLs the frontend hands to the client — host-published
# ports or your public hostnames, never compose service names.
NUXT_PUBLIC_API_BASE=
NUXT_PUBLIC_INGEST_BASE=
