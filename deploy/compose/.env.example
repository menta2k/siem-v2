# Example environment for the compose stack. Copy to .env alongside the
# compose file (git ignores .env) and fill in what you use:
#
#     cp deploy/compose/.env.example deploy/compose/.env
#
# Compose reads this file automatically; only the variables below are
# interpolated into docker-compose.yml. The application services (apiserver,
# logproc, retentiond) run on the HOST in this stack and take their secrets
# from the shell environment, not from this file — see docs/deployment.md.

# Cloudflare Tunnel connector token, from the Zero Trust dashboard
# (Networks → Tunnels → your tunnel → token). Only needed when starting the
# tunnel profile:
#
#     docker compose --profile tunnel up -d
#
# Without the profile the stack ignores this entirely; cloudflared exits
# loudly if the profile is started with the token left empty.
CLOUDFLARE_TUNNEL_TOKEN=
